<Window x:Class="DeskShare.Desktop.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Required"
        Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8"
            Margin="20"
            Padding="25">
        <StackPanel>
            <TextBlock x:Name="ConnectionNameText"
                     Text="Connecting to: Work PC"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Margin="0,0,0,20"/>

            <TextBlock Text="Enter password to connect:"
                     FontSize="14"
                     Foreground="#666666"
                     Margin="0,0,0,10"/>

            <PasswordBox x:Name="PasswordBox"
                       Padding="10,8"
                       FontSize="14"
                       BorderBrush="#CCCCCC"
                       BorderThickness="1"
                       Margin="0,0,0,20"
                       KeyDown="PasswordBox_KeyDown"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Connect"
                      Style="{StaticResource DialogButton}"
                      Click="Connect_Click"
                      IsDefault="True"/>

                <Button Grid.Column="2"
                      Content="Cancel"
                      Style="{StaticResource CancelButton}"
                      Click="Cancel_Click"
                      IsCancel="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
