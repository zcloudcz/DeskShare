<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project references: shared library provides services/models, Core + SignalingServer via transitive -->
  <ItemGroup>
    <ProjectReference Include="..\DeskShare.Desktop.Shared\DeskShare.Desktop.Shared.csproj" />
    <ProjectReference Include="..\SignalingServer\DeskShare.SignalingServer.csproj" />
    <ProjectReference Include="..\Core\DeskShare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- FFmpeg Native Libraries Deployment -->
  <PropertyGroup>
    <FFmpegPath>$(USERPROFILE)\.nuget\packages\ffmpeg.autogen\7.0.0\runtimes\win-x64\native</FFmpegPath>
    <FFmpegLocalPath>$(ProjectDir)ffmpeg</FFmpegLocalPath>
  </PropertyGroup>

  <!-- Copy FFmpeg DLLs to output directory -->
  <ItemGroup>
    <!-- Check if FFmpeg binaries exist in NuGet cache -->
    <FFmpegDlls Include="$(FFmpegPath)\*.dll" Condition="Exists('$(FFmpegPath)')" />
    <!-- Fallback to local ffmpeg folder if exists -->
    <FFmpegDlls Include="$(FFmpegLocalPath)\*.dll" Condition="!Exists('$(FFmpegPath)') And Exists('$(FFmpegLocalPath)')" />
  </ItemGroup>

  <Target Name="CopyFFmpegLibraries" AfterTargets="Build" Condition="'@(FFmpegDlls)' != ''">
    <Message Text="Copying FFmpeg libraries from: @(FFmpegDlls->'%(RootDir)%(Directory)')" Importance="high" />
    <Copy SourceFiles="@(FFmpegDlls)" DestinationFolder="$(OutputPath)ffmpeg" SkipUnchangedFiles="true" />
    <Message Text="FFmpeg libraries copied to output directory: $(OutputPath)ffmpeg" Importance="high" />
  </Target>

  <Target Name="WarnMissingFFmpeg" AfterTargets="Build" Condition="'@(FFmpegDlls)' == ''">
    <Warning Text="FFmpeg native libraries not found! Video decoding will not work." />
    <Message Text="To install FFmpeg, run one of the following:" Importance="high" />
    <Message Text="  1. winget install 'FFmpeg (Shared)' --version 7.0" Importance="high" />
    <Message Text="  2. Run: powershell -ExecutionPolicy Bypass -File $(ProjectDir)download-ffmpeg.ps1" Importance="high" />
    <Message Text="  3. Download from: https://www.gyan.dev/ffmpeg/builds/" Importance="high" />
  </Target>

</Project>
