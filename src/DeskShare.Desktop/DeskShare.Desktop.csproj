<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project references: shared library provides services/models; signaling is a hosted service, see appsettings.json -->
  <ItemGroup>
    <ProjectReference Include="..\DeskShare.Desktop.Shared\DeskShare.Desktop.Shared.csproj" />
    <ProjectReference Include="..\Core\DeskShare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DeskShare</AssemblyName>
    <ApplicationIcon>deskshare.ico</ApplicationIcon>
    <!-- Custom Main (App.xaml.cs) so VelopackApp hooks run before WPF starts -->
    <StartupObject>DeskShare.Desktop.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- FFmpeg native DLLs (FFmpeg 8.x, matching FFmpeg.AutoGen 8.1): ./ffmpeg, filled by download-ffmpeg.ps1 or CI -->
  <ItemGroup>
    <FFmpegDlls Include="$(ProjectDir)ffmpeg\*.dll" />
  </ItemGroup>

  <Target Name="CopyFFmpegLibraries" AfterTargets="Build" Condition="'@(FFmpegDlls)' != ''">
    <Message Text="Copying FFmpeg libraries from: @(FFmpegDlls->'%(RootDir)%(Directory)')" Importance="high" />
    <Copy SourceFiles="@(FFmpegDlls)" DestinationFolder="$(OutputPath)ffmpeg" SkipUnchangedFiles="true" />
    <Message Text="FFmpeg libraries copied to output directory: $(OutputPath)ffmpeg" Importance="high" />
  </Target>

  <Target Name="WarnMissingFFmpeg" AfterTargets="Build" Condition="'@(FFmpegDlls)' == ''">
    <Warning Text="FFmpeg native libraries not found! Video decoding will not work." />
    <Message Text="To install FFmpeg, run one of the following:" Importance="high" />
    <Message Text="  Run: powershell -ExecutionPolicy Bypass -File $(ProjectDir)download-ffmpeg.ps1" Importance="high" />
  </Target>

</Project>
