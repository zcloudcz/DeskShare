<!--
    Password dialog for connecting to password-protected servers.
    Avalonia equivalent of WPF's PasswordDialog.xaml.

    Key differences from WPF:
    - xmlns changed to Avalonia namespace
    - PasswordBox replaced with TextBox + PasswordChar="*" (Avalonia has no PasswordBox)
    - ControlTemplate.Triggers replaced with pseudo-class selectors (:pointerover)
    - IsCancel/IsDefault handled in code-behind
    - ShowInTaskbar replaced with ShowInTaskbar (same name in Avalonia)
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeskShare.DesktopAvalonia.Dialogs.PasswordDialog"
        Title="Password Required"
        Height="220" Width="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F5F5F5"
        ShowInTaskbar="False">

    <Window.Styles>
        <!-- Dialog button style with pseudo-class selectors (replaces WPF Triggers) -->
        <Style Selector="Button.dialogButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>

        <!-- Cancel button style -->
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.cancelButton:pointerover">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
    </Window.Styles>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8"
            Margin="20"
            Padding="25">
        <StackPanel>
            <TextBlock x:Name="ConnectionNameText"
                     Text="Connecting to: Work PC"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Margin="0,0,0,20"/>

            <TextBlock Text="Enter password to connect:"
                     FontSize="14"
                     Foreground="#666666"
                     Margin="0,0,0,10"/>

            <!-- Avalonia has no PasswordBox; use TextBox with PasswordChar instead -->
            <TextBox x:Name="PasswordBox"
                   PasswordChar="*"
                   Padding="10,8"
                   FontSize="14"
                   BorderBrush="#CCCCCC"
                   BorderThickness="1"
                   Margin="0,0,0,20"
                   KeyDown="PasswordBox_KeyDown"/>

            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0"
                      Content="Connect"
                      Classes="dialogButton"
                      Click="Connect_Click"/>

                <Button Grid.Column="2"
                      Content="Cancel"
                      Classes="cancelButton"
                      Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
