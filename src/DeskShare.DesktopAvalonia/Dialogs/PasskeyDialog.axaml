<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DeskShare.DesktopAvalonia.Localization" x:Class="DeskShare.DesktopAvalonia.Dialogs.PasskeyDialog" Title="DeskShare" Height="320" Width="560" WindowStartupLocation="CenterOwner" CanResize="False" Background="#F5F5F5" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Button.dialogButton">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.dialogButton:pointerover">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>
        <Style Selector="Button.cancelButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.cancelButton:pointerover">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="TextAlignment" Value="{Binding TextAlignment, Source={x:Static loc:Loc.Instance}}"/>
            <Setter Property="FlowDirection" Value="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </Window.Styles>
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="20" Padding="25">
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="{Binding [connect.code_required], Source={x:Static loc:Loc.Instance}}" FontSize="14" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <TextBox x:Name="PasskeyTextBox" Padding="10,8" FontSize="16" FontFamily="Consolas" MaxLength="11" BorderBrush="#CCCCCC" BorderThickness="1" Watermark="XXX-XXX-XXX" Margin="0,0,0,20" KeyDown="PasskeyTextBox_KeyDown" FlowDirection="LeftToRight"/>
            <Grid ColumnDefinitions="*,10,*">
                <Button Grid.Column="0" Content="{Binding [connect.action], Source={x:Static loc:Loc.Instance}}" Classes="dialogButton" Click="Ok_Click"/>
                <Button Grid.Column="2" Content="{Binding [nav.back], Source={x:Static loc:Loc.Instance}}" Classes="cancelButton" Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
