<!-- Asks for the permanent password of unattended access (twice). Logic: SetPasswordDialog.axaml.cs -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DeskShare.DesktopAvalonia.Dialogs.SetPasswordDialog"
        Title="Set unattended access password"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#F5F5F5"
        ShowInTaskbar="False">
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="20" Padding="25">
        <StackPanel Spacing="8">
            <TextBlock Text="Permanent password" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B02A37"
                       Text="While unattended access is on, anyone who knows this computer's Server ID and this password can connect to it from anywhere. Use a long password you do not use anywhere else."/>
            <TextBlock Text="Password (at least 12 characters)" FontSize="12" Foreground="#666666" Margin="0,8,0,0"/>
            <TextBox x:Name="PasswordBox" PasswordChar="*" Padding="10,8" FontSize="14"/>
            <TextBlock Text="Repeat password" FontSize="12" Foreground="#666666"/>
            <TextBox x:Name="ConfirmBox" PasswordChar="*" Padding="10,8" FontSize="14" KeyDown="ConfirmBox_KeyDown"/>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#B02A37" TextWrapping="Wrap" IsVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Set password" Click="Ok_Click"/>
                <Button Content="Cancel" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
