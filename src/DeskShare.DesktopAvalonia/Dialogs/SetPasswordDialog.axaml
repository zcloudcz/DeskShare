<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DeskShare.DesktopAvalonia.Localization" x:Class="DeskShare.DesktopAvalonia.Dialogs.SetPasswordDialog" Title="DeskShare" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False" Background="#F5F5F5" ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextAlignment" Value="{Binding TextAlignment, Source={x:Static loc:Loc.Instance}}"/>
            <Setter Property="FlowDirection" Value="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>
    </Window.Styles>
    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="20" Padding="25">
        <StackPanel Spacing="8">
            <TextBlock Text="{Binding [password.label], Source={x:Static loc:Loc.Instance}}" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B02A37" Text="{Binding [password.warning], Source={x:Static loc:Loc.Instance}}"/>
            <TextBlock Text="{Binding [password.rules], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="#666666" Margin="0,8,0,0"/>
            <TextBox x:Name="PasswordBox" PasswordChar="*" Padding="10,8" FontSize="14" FlowDirection="LeftToRight"/>
            <TextBlock Text="{Binding [password.repeat], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="#666666"/>
            <TextBox x:Name="ConfirmBox" PasswordChar="*" Padding="10,8" FontSize="14" KeyDown="ConfirmBox_KeyDown" FlowDirection="LeftToRight"/>
            <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#B02A37" TextWrapping="Wrap" IsVisible="False"/>
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{Binding [password.set], Source={x:Static loc:Loc.Instance}}" Click="Ok_Click"/>
                <Button Content="{Binding [nav.back], Source={x:Static loc:Loc.Instance}}" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
