<!-- "Unattended access" card of the Server Mode tab (Windows only; hides itself elsewhere). Logic: UnattendedAccessPanel.axaml.cs -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeskShare.DesktopAvalonia.Controls.UnattendedAccessPanel">
    <Border Classes="card" Margin="10,10,10,10">
        <StackPanel>
            <TextBlock Text="Unattended access" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Installs a Windows service that keeps the screen sender running, also at the sign-in screen and after a reboot. Requires administrator approval."
                       FontSize="11" Foreground="#495057" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="Status: ..." FontSize="14" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="EnableButton" Content="Enable unattended access" Classes="modernButton" Click="OnEnable"/>
                <Button x:Name="UpdateButton" Content="Update service" Classes="modernButton" Click="OnEnable" IsVisible="False"/>
                <Button x:Name="DisableButton" Content="Disable unattended access" Classes="modernButton" Click="OnDisable" IsVisible="False"/>
            </StackPanel>
            <!-- Permanent password: lets a viewer connect with Server ID + password instead of the rotating passkey. -->
            <StackPanel x:Name="PasswordPanel" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" IsVisible="False">
                <Button x:Name="SetPasswordButton" Content="Set password..." Classes="modernButton" Click="OnSetPassword"/>
                <Button x:Name="ClearPasswordButton" Content="Remove password" Classes="modernButton" Click="OnClearPassword"/>
                <!-- Signed in to ZCLOUD only: lists the unattended agent's Server ID under "My devices". -->
                <Button x:Name="AddToMyDevicesButton" Content="Add to my devices" Classes="modernButton" Click="OnAddToMyDevices" IsVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
