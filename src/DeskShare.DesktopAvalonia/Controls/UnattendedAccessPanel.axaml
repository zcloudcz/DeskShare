<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DeskShare.DesktopAvalonia.Localization" x:Class="DeskShare.DesktopAvalonia.Controls.UnattendedAccessPanel">
    <Border Classes="card" Margin="10,10,10,10">
        <StackPanel>
            <TextBlock Text="{Binding [unattended.label], Source={x:Static loc:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding [unattended.explain], Source={x:Static loc:Loc.Instance}}" FontSize="11" Foreground="#495057" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="{Binding [status.notinstalled], Source={x:Static loc:Loc.Instance}}" FontSize="14" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="EnableButton" Content="{Binding [action.enable], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnEnable"/>
                <Button x:Name="UpdateButton" Content="{Binding [action.update], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnEnable" IsVisible="False"/>
                <Button x:Name="DisableButton" Content="{Binding [action.disable], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnDisable" IsVisible="False"/>
            </StackPanel>
            <!-- Permanent password: lets a viewer connect with Server ID + password instead of the rotating passkey. -->
            <StackPanel x:Name="PasswordPanel" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" IsVisible="False">
                <Button x:Name="SetPasswordButton" Content="{Binding [password.set], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnSetPassword"/>
                <Button x:Name="ClearPasswordButton" Content="{Binding [password.remove], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnClearPassword"/>
                <!-- Signed in to ZCLOUD only: lists the unattended agent's Server ID under "My devices". -->
                <Button x:Name="AddToMyDevicesButton" Content="{Binding [devices.add], Source={x:Static loc:Loc.Instance}}" Classes="modernButton" Click="OnAddToMyDevices" IsVisible="False"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
