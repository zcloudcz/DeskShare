{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5151"
      },
      "Https": {
        "Url": "https://localhost:5152"
      }
    }
  },
  "Security": {
    "AllowLegacyConnections": true,
    "RequireHmacSignature": false
  },
  "Turn": {
    "Enabled": true,
    "EnableTestUser": true
  }
}
