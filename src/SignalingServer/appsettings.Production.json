{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "DeskShare": "Information"
    }
  },
  "AllowedHosts": "<production-domain>",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://+:5151",
        "Certificate": {
          "Path": "certs/server.pfx",
          "Password": ""
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://<production-domain>"
    ]
  },
  "Storage": {
    "Type": "AzureTableStorage",
    "AzureTableStorage": {
      "ConnectionString": ""
    }
  },
  "RateLimiting": {
    "Authenticate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "WebSocket": {
    "MaxConnections": 100,
    "IdleTimeoutSeconds": 300,
    "TokenExpirationSeconds": 30,
    "MaxMessageSize": 16384
  },
  "Stun": {
    "Port": 3478
  },
  "Security": {
    "AllowLegacyConnections": false,
    "RequireHmacSignature": true,
    "DiagnosticsApiKey": ""
  },
  "Turn": {
    "Enabled": false,
    "EnableTestUser": false,
    "Port": 3479,
    "Realm": "DeskShare",
    "MinRelayPort": 49152,
    "MaxRelayPort": 65535
  },
  "IceServers": [
    { "Urls": "stun:stun.l.google.com:19302" },
    {
      "Urls": "turn:<production-domain>:3478",
      "Username": "",
      "Credential": ""
    }
  ],
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/signaling-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/audit-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  }
}
