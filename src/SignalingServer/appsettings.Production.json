{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "DeskShare": "Information"
    }
  },
  "AllowedHosts": "app.deskshare.zcloud.cz;deskshare-signaling.azurewebsites.net",
  "Cors": {
    "AllowedOrigins": [
      "https://app.deskshare.zcloud.cz",
      "https://deskshare.zcloud.cz"
    ]
  },
  "Storage": {
    "Type": "InMemory"
  },
  "RateLimiting": {
    "Authenticate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "WebSocket": {
    "MaxConnections": 100,
    "IdleTimeoutSeconds": 300,
    "TokenExpirationSeconds": 30,
    "MaxMessageSize": 16384
  },
  "Stun": {
    "Enabled": false
  },
  "Turn": {
    "Enabled": false,
    "EnableTestUser": false
  },
  "Security": {
    "AllowLegacyConnections": false,
    "RequireHmacSignature": true,
    "DiagnosticsApiKey": ""
  },
  "IceServers": [
    { "Urls": "stun:stun.l.google.com:19302" },
    { "Urls": "stun:stun1.l.google.com:19302" }
  ],
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
