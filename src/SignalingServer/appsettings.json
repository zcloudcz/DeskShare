{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5151"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5001",
      "https://localhost:7001"
    ]
  },
  "Storage": {
    "Type": "InMemory",
    "AzureTableStorage": {
      "ConnectionString": ""
    }
  },
  "RateLimiting": {
    "Authenticate": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "WebSocket": {
    "MaxConnections": 100,
    "IdleTimeoutSeconds": 300,
    "TokenExpirationSeconds": 30,
    "MaxMessageSize": 16384
  },
  "Stun": {
    "Port": 3478
  },
  "IceServers": [
    { "Urls": "stun:stun.l.google.com:19302" },
    { "Urls": "stun:stun1.l.google.com:19302" }
  ],
  "Security": {
    "AllowLegacyConnections": false,
    "RequireHmacSignature": true,
    "DiagnosticsApiKey": ""
  },
  "Turn": {
    "Enabled": false,
    "Port": 3479,
    "Realm": "DeskShare",
    "EnableTestUser": false,
    "MinRelayPort": 49152,
    "MaxRelayPort": 65535
  }
}
