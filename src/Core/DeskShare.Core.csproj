<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests shorten the signaling keep-alive timings (WebSocketSignaler.KeepAliveInterval/DeadAfter). -->
    <InternalsVisibleTo Include="DeskShare.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="SIPSorceryMedia.FFmpeg" Version="10.0.16" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
    <!-- Wayland portal D-Bus client. Avalonia already ships this package (0.20.0); 0.21.3 is the patched release (CVE-2026-39959) and stays binary compatible with what Avalonia 11.2 calls. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <!-- libvpx (vpxmd.dll from SIPSorceryMedia.Encoders, VP8 encode and decode) links the VC++ runtime dynamically and fails
       to load on a clean Windows without the VC++ Redistributable (no VP8 video at all on a PC without a GPU encoder).
       vcruntime140.dll is a redistributable file Microsoft allows to ship next to the app ("app-local"), so it is copied
       from the build machine (any Windows with the redistributable, e.g. the CI runner) into every app and agent output. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(SystemRoot)\System32\vcruntime140.dll')">
    <None Include="$(SystemRoot)\System32\vcruntime140.dll" Link="vcruntime140.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
